# bettercallgpt configuration — copy to ~/.config/bettercallgpt/.env (installed) or ./.env (checkout).
# Secrets and endpoints only. The environment always wins over this file, and harness-control
# names (BETTERCALLGPT_*, VOICE_BUTLER_*) are refused from it.

# --- voice provider: Azure Voice Live (default) ------------------------------------------
AZURE_OPENAI_API_KEY=PASTE_YOUR_AZURE_OPENAI_KEY_HERE  # SECRET
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# VOICE_MODEL=gpt-realtime-2.1  # realtime deployment name
# VOICE_LIVE_VAD=azure_semantic_vad  # server turn detection (duplex + barge-in stay on)

# --- or OpenAI Realtime -------------------------------------------------------------------
# VOICE_LIVE_PROVIDER=openai
# OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE  # SECRET
# VOICE_MODEL=gpt-realtime

# --- or Azure GPT-Live (gpt-live-1; its own resource — use headphones, no server echo cancellation)
# VOICE_LIVE_PROVIDER=gpt_live
# VOICE_GPT_LIVE_ENDPOINT=https://YOUR-GPT-LIVE-RESOURCE.openai.azure.com
# VOICE_GPT_LIVE_API_KEY=PASTE_YOUR_KEY   # SECRET

# --- optional knobs (no secrets) ----------------------------------------------------------
# VOICE_TRANSCRIBE_MODEL=whisper-1   # speech-to-text for your words (gpt-4o-transcribe also works)
# VOICE_NAME=marin  # voice
# VOICE_BACKEND=claude_code  # claude_code | process
# VOICE_PROCESS_ARGV=codex exec --json  # process backend: the child agent
# VOICE_IDLE_MINUTES=10  # quiet minutes before goodbye; 0 = never
# VOICE_SESSION_ROLLOVER_MINUTES=55  # renew the voice provider session before its own limit; 0 = off
# Hard session cap in minutes; leave empty for no cap:
# VOICE_SESSION_MAX_MINUTES=
# VOICE_LISTEN_STATE_DIR is read from the ENVIRONMENT only (export it); a value here is ignored.
